{
  "name": "colorlink",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "colorlink",
      "version": "0.1.0",
      "workspaces": [
        "apps/*",
        "packages/*"
      ],
      "engines": {
        "node": ">=20"
      }
    },
    "apps/calendar": {
      "name": "@colorlink/calendar",
      "version": "0.0.0"
    },
    "apps/clock": {
      "name": "@colorlink/clock",
      "version": "0.1.0"
    },
    "apps/notes": {
      "name": "@colorlink/notes",
      "version": "0.0.0"
    },
    "node_modules/@colorlink/agent-core": {
      "resolved": "packages/agent-core",
      "link": true
    },
    "node_modules/@colorlink/calendar": {
      "resolved": "apps/calendar",
      "link": true
    },
    "node_modules/@colorlink/clock": {
      "resolved": "apps/clock",
      "link": true
    },
    "node_modules/@colorlink/notes": {
      "resolved": "apps/notes",
      "link": true
    },
    "packages/agent-core": {
      "name": "@colorlink/agent-core",
      "version": "0.1.0"
    }
  }
}
