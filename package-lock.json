{
  "name": "pocket",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "pocket",
      "version": "0.1.0",
      "workspaces": [
        "apps/*",
        "packages/*"
      ],
      "engines": {
        "node": ">=20"
      }
    },
    "apps/calendar": {
      "name": "@pocket/calendar",
      "version": "0.0.0"
    },
    "apps/clock": {
      "name": "@pocket/clock",
      "version": "0.1.1"
    },
    "apps/notes": {
      "name": "@pocket/notes",
      "version": "0.0.0"
    },
    "node_modules/@pocket/agent-core": {
      "resolved": "packages/agent-core",
      "link": true
    },
    "node_modules/@pocket/calendar": {
      "resolved": "apps/calendar",
      "link": true
    },
    "node_modules/@pocket/clock": {
      "resolved": "apps/clock",
      "link": true
    },
    "node_modules/@pocket/notes": {
      "resolved": "apps/notes",
      "link": true
    },
    "packages/agent-core": {
      "name": "@pocket/agent-core",
      "version": "0.1.0"
    }
  }
}
