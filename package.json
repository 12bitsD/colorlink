{
  "name": "pocket",
  "version": "0.1.0",
  "private": true,
  "description": "Agent-native clock, calendar, and notes for Android",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "check": "node scripts/check-clock.js",
    "test": "node --test packages/agent-core/test/*.test.js",
    "style": "bits style check . --baseline bits-baseline.json",
    "style:diff": "bits style check --diff --commit origin/main",
    "style:fix": "bits style fix --diff --commit origin/main",
    "style:report": "bits style report ."
  },
  "engines": {
    "node": ">=20"
  }
}
